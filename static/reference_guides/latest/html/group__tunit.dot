digraph "unit tests"
{
 // INTERACTIVE_SVG=YES
 // LATEX_PDF_SIZE
  bgcolor="transparent";
  edge [fontname=Helvetica,fontsize=10,labelfontname=Helvetica,labelfontsize=10];
  node [fontname=Helvetica,fontsize=10,shape=box,height=0.2,width=0.4];
  rankdir=LR;
  Node2 [id="Node000002",label="assertions",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$group__assertions.html",tooltip="Contains assertions definitions."];
  Node3 [id="Node000003",label="assumptions",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$group__assumptions.html",tooltip="Contains assumptions definitions."];
  Node6 [id="Node000006",label="events",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$group__events.html",tooltip="events are event args and event handler needed to response to window messages."];
  Node1 [id="Node000001",label="unit tests",height=0.2,width=0.4,color="gray40", fillcolor="grey60", style="filled", fontcolor="black",tooltip="Contains unit tests definitions."];
  Node4 [id="Node000004",label="validations",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$group__validations.html",tooltip="Contains validations definitions."];
  Node5 [id="Node000005",label="xtd.tunit",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$group__xtd__tunit.html",tooltip="The xtd.tunit library contains components needed for unit testing."];
  Node1->Node2 [shape=plaintext, dir="back", style="solid"];
  Node1->Node3 [shape=plaintext, dir="back", style="solid"];
  Node1->Node4 [shape=plaintext, dir="back", style="solid"];
  Node1->Node5 [shape=plaintext, label="xtd::tunit::base_assert\nxtd::tunit::class_cleanup\l_attribute\nxtd::tunit::class_event_args\nxtd::tunit::class_initialize\l_attribute\nxtd::tunit::console\l_unit_test\nxtd::tunit::event_listener\nxtd::tunit::ostream\l_event_listener\nxtd::tunit::ostream\l_unit_test\nxtd::tunit::register\l_test_class_types\nxtd::tunit::registered\l_test_class\nxtd::tunit::settings\nxtd::tunit::test\nxtd::tunit::test_class\nxtd::tunit::test_class\l_attribute\nxtd::tunit::test_cleanup\l_attribute\nxtd::tunit::test_event_args\nxtd::tunit::test_method\l_attribute\nxtd::tunit::tunit_event_args\nxtd::tunit::unit_test", color="orange", dir="none", style="dashed"];
  Node1->Node6 [shape=plaintext, label="xtd::tunit::class_event_args\nxtd::tunit::test_event_args\nxtd::tunit::tunit_event_args", color="orange", dir="none", style="dashed"];
